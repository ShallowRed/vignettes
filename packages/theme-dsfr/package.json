{
  "name": "@vignettes/theme-dsfr",
  "type": "module",
  "version": "0.1.0",
  "description": "Base theme for Vignettes following the French state design system (DSFR): palette, Marianne typography, dsfr-layout scale. Brand-neutral, made to be extended.",
  "author": "Lucas Poulain",
  "license": "MIT",
  "homepage": "https://github.com/ShallowRed/vignettes/tree/main/packages/theme-dsfr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShallowRed/vignettes.git",
    "directory": "packages/theme-dsfr"
  },
  "bugs": "https://github.com/ShallowRed/vignettes/issues",
  "keywords": [
    "reveal.js",
    "slides",
    "presentation",
    "theme",
    "scss",
    "sass",
    "dsfr",
    "design-system"
  ],
  "exports": {
    ".": {
      "sass": "./index.scss"
    },
    "./fonts": {
      "sass": "./_fonts.scss"
    },
    "./variables": {
      "sass": "./_variables.scss"
    },
    "./standalone": {
      "sass": "./standalone.scss"
    }
  },
  "files": [
    "*.scss"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vignettes/theme-kit": "workspace:^"
  }
}
