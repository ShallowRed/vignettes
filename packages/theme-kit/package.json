{
  "name": "@vignettes/theme-kit",
  "type": "module",
  "version": "0.1.0",
  "description": "Engine CSS layer for Vignettes themes: semantic token contract, Reveal patches, media layouts, slide structure, scale presets.",
  "author": "Lucas Poulain",
  "license": "MIT",
  "homepage": "https://github.com/ShallowRed/vignettes/tree/main/packages/theme-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShallowRed/vignettes.git",
    "directory": "packages/theme-kit"
  },
  "bugs": "https://github.com/ShallowRed/vignettes/issues",
  "keywords": [
    "reveal.js",
    "slides",
    "presentation",
    "theme",
    "scss",
    "sass",
    "design-tokens"
  ],
  "exports": {
    ".": {
      "sass": "./_index.scss"
    },
    "./base": {
      "sass": "./_base.scss"
    },
    "./presets/layout": {
      "sass": "./presets/layout/_index.scss"
    }
  },
  "files": [
    "*.scss",
    "presets"
  ],
  "publishConfig": {
    "access": "public"
  }
}
