    "@nuxt/ui": "catalog:",
    "@nuxtjs/mdc": "catalog:",
    "@pinia/colada": "catalog:",
    "@pinia/colada-nuxt": "catalog:",
    "@pinia/nuxt": "catalog:",
    "@tanstack/vue-table": "catalog:",
    "@types/node": "catalog:",
    "better-sqlite3": "catalog:",
