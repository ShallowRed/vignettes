{
  "name": "nuxt-slides",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm build:themes && nuxt dev",
    "dev:theme": "node scripts/build-themes.ts --watch",
    "build": "pnpm build:themes && nuxt build",
    "build:themes": "node scripts/build-theme-tokens.ts && node scripts/build-themes.ts",
    "build:theme": "node scripts/build-themes.ts",
    "generate": "pnpm build:themes && nuxt generate",
    "preview": "nuxt preview",
    "preview:static": "pnpm generate && nuxt preview",
    "prepare": "nuxt prepare",
    "hash-password": "node scripts/hash-password.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
