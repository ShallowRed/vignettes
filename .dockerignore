# Contexte de build Docker. On EXCLUT les artefacts et deps locaux ; on GARDE les
# sources, presentations/ (submodule), .frozen-mirror/ (filet origin-root), public/,
# themes/, scripts/, server/, shared/, plugins/.

.git
.github
node_modules
.nuxt
.nitro
.output
.data
.cache
dist
dist-standalone
export

# Bundles gelés : désormais en object storage (Scaleway), plus bakés dans l'image
# (servis par server/routes/frozen depuis le bucket). Voir docs/frozen-storage.md.
.frozen/
*.log
.DS_Store
.vscode
.fleet
.idea

# Fichiers d'env locaux (les secrets runtime passent par le compose sur le VPS)
.env
.env.*
!.env.example

# Doc / tests / gros binaires inutiles au build
docs
test
slides.pptx
