# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Exports (may contain sensitive content)
export/*
!export/.gitkeep

# Temporary clone directory for fetching presentations
.presentations-temp

# Standalone bundle artifacts
dist-standalone/
presentations/public/_storybook-bundle/
presentations/public/*--standalone.md

# Frozen-presentation bundles: generated by `make freeze`, hosted in object storage
# (Scaleway) and served by `server/routes/frozen/[...path].ts` — NOT in git. Local
# `.frozen/` stays as a dev cache + upload source; `.frozen-mirror/` is vestigial.
.frozen/
.frozen-mirror/

# Uploaded media: stored in the same object storage under `media/` and served by
# `server/routes/media/[...path].ts`. Local `.media/` is the dev fallback — NOT in git.
.media/

# Docs personnelles / temporaires / audits (hors repo public)
docs/private/

# mise personal overrides
mise.local.toml

# Compiled themes and their copied assets (`pnpm build:themes`)
public/themes/
