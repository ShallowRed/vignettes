# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Exports (may contain sensitive content)
export/*
!export/.gitkeep

# Temporary clone directory for fetching presentations
.presentations-temp


# Frozen bundles: built by `mise run freeze`, uploaded to object storage and
# served by `server/routes/frozen/[...path].ts`. `.frozen/` is the local build
# output and upload source, never committed.
.frozen/

# Uploaded media: stored in the same object storage under `media/` and served by
# `server/routes/media/[...path].ts`. Local `.media/` is the dev fallback — NOT in git.
.media/

# Docs personnelles / temporaires / audits (hors repo public)
docs/private/

# mise personal overrides
mise.local.toml

# Compiled themes and their copied assets (`pnpm build:themes`)
public/themes/

# Agent and editor scratch: kept locally, out of the published repository
CONTRIBUTING.md
.tooling/

# Identity map: applied to the history once, then kept out of the published tree
