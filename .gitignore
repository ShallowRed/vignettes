# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Exports (may contain sensitive content)
export/*
!export/.gitkeep

# Temporary clone directory for fetching presentations
.presentations-temp

# Standalone bundle artifacts
dist-standalone/
presentations/public/_storybook-bundle/
presentations/public/*--standalone.md

# Frozen-presentation bundles (DDR-018). GENERATED by `make freeze` and now hosted
# in object storage (Scaleway), NOT in git: `make upload-frozen` pushes them to the
# bucket and `server/routes/frozen/[...path].ts` serves them (gated). Local `.frozen/`
# stays as a dev cache + upload source. See docs/frozen-storage.md.
.frozen/
.env*
.frozen-mirror/
