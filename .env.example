# Copy this file to .env, or run `mise run setup`, which copies it and fills
# NUXT_SESSION_PASSWORD with a generated value.

# Session cookie secret (required), 32 characters minimum.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars

# OAuth sign-in. The login page only shows the providers that have credentials.
# With neither pair filled in, sign-in is only available through
# /auth/dev-login?role=owner, which answers in development only.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Handles that receive a global role at login (comma-separated). Any other
# authenticated handle is a viewer. With NUXT_OWNER_LOGINS empty, the first
# account that signs in becomes the owner.
NUXT_OWNER_LOGINS=
NUXT_EDITOR_LOGINS=

# PostgreSQL server, as a postgres:// URL whose sslmode sets TLS. On Scalingo:
# NUXT_DATABASE_URL=$SCALINGO_POSTGRESQL_URL. Without it, the app runs PGlite
# in NUXT_PGLITE_DIR (default: .data/pglite).
# NUXT_DATABASE_URL=
# NUXT_PGLITE_DIR=

# Set to sqlite to run on the SQLite file of NUXT_DB_PATH (default: .data/slides.db).
# NUXT_DATABASE_DRIVER=sqlite
# NUXT_DB_PATH=

# Directory of the content space: the deck stubs `mise run content:import`
# reads, and the themes of a tenant's own brands (default: presentations)
# NUXT_CONTENT_DIR=

# The number of proxies in front of the server that append the client address
# to X-Forwarded-For: 1 behind Caddy or the Scalingo router. The rate limits
# count by the socket address without it.
# NUXT_TRUSTED_PROXY_HOPS=1

# Bearer token for `mise run content:republish:prod` (markdown write routes only)
# NUXT_CONTENT_TOKEN=

# Object storage (S3-compatible) for frozen bundles, uploaded media, published
# tenant themes and the database replica. The bucket name and the two keys go
# together: without them the app serves .frozen/, .media/ and .themes/ from disk
# and runs without replication. The endpoint and the region below are an example.
NUXT_FROZEN_S3_ENDPOINT=https://s3.fr-par.scw.cloud
NUXT_FROZEN_S3_REGION=fr-par
NUXT_FROZEN_S3_BUCKET=
NUXT_FROZEN_S3_ACCESS_KEY_ID=
NUXT_FROZEN_S3_SECRET_ACCESS_KEY=
# Folder of the bucket for the published themes of this instance, for an
# instance that shares the bucket with another one (staging): <prefix>/themes/.
# NUXT_FROZEN_S3_THEMES_PREFIX=

# Demonstration and acceptance kit (/recette): nine decks covering the access
# matrix and five test personas. Always on in development; set to 1 to expose it
# on a deployed staging or demonstration instance, which then creates the data
# set at boot.
# NUXT_RECETTE_ENABLED=1

# Theme a deck falls back to when its frontmatter declares none, and the one the
# create form preselects (default: dsfr).
# NUXT_PUBLIC_DEFAULT_THEME=dsfr

# Links of the studio, in the header and in the status bar of the editor, each
# hidden while empty: the documentation of the instance, and where its users
# send their feedback (a form, an email address as mailto:).
# NUXT_PUBLIC_HELP_URL=
# NUXT_PUBLIC_FEEDBACK_URL=

# The sentence under the title of the home page, for a visitor without an
# account: what this instance publishes, for whom. It is written in one
# language, shown as it is in French and in English. Empty, the studio shows a
# sentence of its messages, in the language of the interface.
# NUXT_PUBLIC_WELCOME=

# The name of the instance, after « Vignettes » in the header of the home page,
# in the page titles and in the link previews. Empty, the studio shows
# « Vignettes » alone.
# NUXT_PUBLIC_INSTANCE_NAME=

# The interface theme of the instance: vignettes (default), dsfr or lasuite.
# NUXT_PUBLIC_UI_THEME=

# The Umami service of the instance and its websites for the studio and for the
# decks. Empty, the instance sends no page view. The privacy page states the
# retention period in months, and leaves the sentence out while it is empty.
# NUXT_PUBLIC_UMAMI_HOST=https://stats.example.org
# NUXT_PUBLIC_UMAMI_STUDIO_WEBSITE_ID=
# NUXT_PUBLIC_UMAMI_DECKS_WEBSITE_ID=
# NUXT_PUBLIC_UMAMI_RETENTION_MONTHS=

# The DSN of the GlitchTip project of the instance and the name of its
# environment. Empty, the instance reports no error. The privacy page states the
# retention period in days, and leaves the sentence out while it is empty.
# NUXT_PUBLIC_ERROR_TRACKING_DSN=
# NUXT_PUBLIC_ERROR_TRACKING_ENVIRONMENT=
# NUXT_PUBLIC_ERROR_TRACKING_RETENTION_DAYS=

# The address the privacy page gives for questions about personal data.
# NUXT_PUBLIC_PRIVACY_CONTACT=

# The origin of the deck pages, apart from the studio, so that a script of a
# deck never runs with a session of the studio. Set both addresses, on two
# hosts that reach this server; the deck address is on another registrable
# domain than the studio, so that a deck page cannot set a cookie the studio
# reads. Empty, one origin serves everything.
# NUXT_PUBLIC_DECKS_URL=https://decks.example.org
# NUXT_STUDIO_URL=https://studio.example.org
