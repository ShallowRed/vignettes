# Copy this file to .env, or run `mise run setup`, which copies it and fills
# NUXT_SESSION_PASSWORD with a generated value.

# Session cookie secret (required), 32 characters minimum.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-chars

# OAuth sign-in. The login page only shows the providers that have credentials.
# With neither pair filled in, sign-in is only available through
# /auth/dev-login?role=owner, which answers in development only.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Handles that receive a global role at login (comma-separated). Any other
# authenticated handle is a viewer. With NUXT_OWNER_LOGINS empty, the first
# account that signs in becomes the owner.
NUXT_OWNER_LOGINS=
NUXT_EDITOR_LOGINS=

# SQLite database file (default: .data/slides.db)
# NUXT_DB_PATH=

# Directory of the content space: the deck stubs `mise run content:import`
# reads, and the themes of a tenant's own brands (default: presentations)
# NUXT_CONTENT_DIR=

# Bearer token for `mise run content:republish:prod` (markdown write routes only)
# NUXT_CONTENT_TOKEN=

# Object storage (S3-compatible) for frozen bundles, uploaded media, published
# tenant themes and the database replica. The bucket name and the two keys go
# together: without them the app serves .frozen/, .media/ and .themes/ from disk
# and runs without replication. The endpoint and the region below are an example.
NUXT_FROZEN_S3_ENDPOINT=https://s3.fr-par.scw.cloud
NUXT_FROZEN_S3_REGION=fr-par
NUXT_FROZEN_S3_BUCKET=
NUXT_FROZEN_S3_ACCESS_KEY_ID=
NUXT_FROZEN_S3_SECRET_ACCESS_KEY=

# Demonstration and acceptance kit (/recette): eight decks covering the access
# matrix and five test personas. Always on in development; set to 1 to expose it
# on a deployed staging or demonstration instance.
# NUXT_RECETTE_ENABLED=1

# Theme a deck falls back to when its frontmatter declares none, and the one the
# create form preselects (default: dsfr).
# NUXT_PUBLIC_DEFAULT_THEME=dsfr
